# SIH26099 — Backend Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file.

# Application
APP_ENV=development
APP_DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://sih_user:changeme@localhost:5433/sih_dev

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API
API_V1_PREFIX=/api/v1
# Preferred production config: comma-separated list of valid reviewer tokens.
# Example: REVIEWER_TOKENS="token_a, token_b, token_c"
REVIEWER_TOKENS="token_a, token_b, token_c"
# Backward-compatible single-token fallback used only if REVIEWER_TOKENS is unset.
REVIEWER_TOKEN="placeholder_token_replace_me"
